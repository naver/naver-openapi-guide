            "default": "진주",
            "type": "string"
          },
          {
            "name": "display",
            "in": "query",
            "description": "검색결과 출력건수 (10 ~ 100)",
            "required": false,
            "default": 10,
            "type": "integer"
          },
          {
            "name": "start",
            "in": "query",
            "description": "검색 시작 위치 (1~ 1000, [**1000 이상은 불가**])",
            "required": false,
            "default": 1,
            "type": "integer"
          },
          {
            "name": "sort",
            "in": "query",
            "description": "정렬 옵션: random(유사도순), comment(카페/블로그 리뷰 개수 순)",
            "required": false,
