    "/v1/cafe/{clubid}/members": {
      "post": {
        "tags": [
          "Naver Login"
        ],
        "summary": "Naver Login-카페 가입",
        "description": "네이버 로그인을 통해 인증받은 사용자 계정으로 clubid로 지정된 카페에 가입하는 API입니다",
        "operationId": "cafe.members",
        "consumes": [
          "application/x-www-form-urlencoded"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "clubid",
            "in": "path",
            "description": "카페 아이디 <br/> 카페 관리 페이지와 같이 카페 내 이동 시 clubid로 표현되는 파라미터는 카페의 고유 아이디입니다. (http://cafe.naver.com/ManageHome.nhn?clubid=14447337 의 14447337값이 clubid입니다.)",
            "required": true,
            "type": "string"
